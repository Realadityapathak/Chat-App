# Server Configuration (copy to backend/.env)
PORT=3000
MONGO_URI=mongodb://127.0.0.1:27017/samvad_db
NODE_ENV=development
JWT_SECRET=your_jwt_secret_key_at_least_32_chars
CLIENT_URL=http://localhost:5173

# Optional: Transactional Email (Resend)
RESEND_API_KEY=your_resend_api_key
EMAIL_FROM=onboarding@resend.dev
EMAIL_FROM_NAME=Samvad

# Optional: Cloud Image Storage (Cloudinary)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Optional: Bot Detection & Rate Limiting (Arcjet)
ARCJET_KEY=your_arcjet_api_key
ARCJET_ENV=development
